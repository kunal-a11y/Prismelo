# ---------------------------------------------------------------------------
# Prismelo website — environment variables
# ---------------------------------------------------------------------------
# Copy to `.env.local` for local development. Never commit real values.
# All of these are server-only: none are exposed to the browser.

# Contact form delivery and community notifications (optional).
# Without an SMTP relay the contact form responds 501 and community emails are
# recorded as "skipped" in the admin email log. Nothing is ever reported as
# sent when it was not.
# See /docs/guides/contact-form-integration
# Port 587 upgrades with STARTTLS, port 465 uses implicit TLS.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Verified sender at the relay, e.g. "Prismelo <hello@prismelo.tech>".
# Falls back to EMAIL_FROM, then to the SMTP login.
CONTACT_FROM_EMAIL=
# Destination for enquiries. Falls back to the site contact address.
CONTACT_TO_EMAIL=
# Sender for community notifications. Falls back to CONTACT_FROM_EMAIL.
EMAIL_FROM=

# Admin publishing area at /admin.
# Without ADMIN_PASSWORD the admin pages render a setup notice and sign-in is
# refused — there is deliberately no default password. Writes go to
# content/resources, so this works on a self-hosted Node server.
ADMIN_PASSWORD=
# Optional: keeps existing sessions valid when the password changes.
# Defaults to a key derived from ADMIN_PASSWORD.
ADMIN_SESSION_SECRET=

# Community accounts and sessions.
# Optional: defaults to ADMIN_SESSION_SECRET, then ADMIN_PASSWORD. With none of
# those set, registration is refused rather than using a guessable key.
COMMUNITY_SESSION_SECRET=
