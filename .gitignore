# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*

# next.js
/.next/
/.open-next/
/.wrangler/
/out/
next-env.d.ts

# production
/build

# misc
.DS_Store
*.pem
*.tsbuildinfo

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
# .env is committed on purpose: this repository is private and the deployment
# reads it directly, so a clone works without configuring the host. If the repo
# is ever made public or shared, rotate every key in it first.
.env*.local
.env.development
.env.production

# vercel
.vercel

# typescript
*.tsbuildinfo

# community data: emails, password hashes, email log (never commit personal data)
/data/

# local dev logs
*.log
